{
    "name": "semperton/routing",
    "description": "The Semperton Routing component.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Semperton\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semperton\\Routing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "check": "psalm --no-cache",
        "bench": "phpbench run benchmark --report=aggregate"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0",
        "phpbench/phpbench": "^1.4"
    },
    "require": {
        "php": "^8.2",
        "psr/http-message": "^1.1 || ^2.0"
    }
}
